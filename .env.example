# Runtime / Infra
HTTP_TIMEOUT_SECONDS=10

# Google Chat / Notificacoes
GCHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SUBSTITUA_SPACE/messages?key=SUBSTITUA_KEY&token=SUBSTITUA_TOKEN

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=
LOG_DIR=logs

# Deduplicacao
DEDUP_ENABLED=false
DEDUP_WINDOW_MINUTES=30

# Janela Comercial Compartilhada (WINDOW_*)
WINDOW_ENABLED=true
WINDOW_DAYS=mon,tue,wed,thu,fri
WINDOW_START=09:00
WINDOW_END=18:00
WINDOW_TIMEZONE=America/Sao_Paulo

# OTRS (Exclusivo OTRS)
OTRS_BASE_URL=https://portal.ilegra.com/otrs/index.pl
OTRS_DB_HOST=127.0.0.1
OTRS_DB_PORT=3306
OTRS_DB_NAME=otrs
OTRS_DB_USER=otrs
OTRS_DB_PASSWORD=otrssecret
